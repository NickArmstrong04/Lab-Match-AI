# Supabase Configurations
# Obtain these from your Supabase Dashboard -> Project Settings -> API
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_KEY="your-supabase-service-role-key-or-anon-key"

# Gemini API Key (Required)
# Powers both the embedding layer (gemini-embedding-001) and the ghostwriter drafts
# plus abstract expansion (gemini-2.5-flash). The backend warns at startup if this is
# missing, and matching/drafting will fail at runtime.
# Obtain from Google AI Studio -> Get API key.
GEMINI_API_KEY=""

# OpenAI API Key (Optional)
# If set, embeddings are computed with text-embedding-3-small. If left blank -- or if
# the call fails -- the backend falls through to Gemini, which is the normal path.
# Leave it empty unless you specifically want OpenAI embeddings.
OPENAI_API_KEY=""

# Google OAuth Configurations (sign-in only)
# Used for identity only -- the app requests `openid` + `userinfo.email` and has no
# Gmail send scope. It does not send email; the composer produces a draft the student
# copies into their own mail client.
# Set up a Google Cloud Project and configure the OAuth Consent Screen.
# Obtain these from Google Cloud Console -> Credentials -> OAuth 2.0 Client IDs.
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:8000/auth/google/callback"

# Origin of the frontend SPA. REQUIRED IN PRODUCTION.
# The OAuth callback popup postMessages its result to exactly this origin (it used to
# broadcast to "*", which handed the payload to any listening window). If this is left
# at the localhost default on a deployed backend, the browser silently drops the
# message and Google sign-in appears to hang at "Handshake Complete!" -- there is no
# error, so set it deliberately. Scheme + host + port, no trailing slash.
FRONTEND_ORIGIN="http://localhost:5173"

# Outbound SMTP for password-reset emails (Optional -- but reset is disabled without it)
# The app's ONLY send path; outreach pitches are still copy-paste by design. If
# SMTP_USERNAME/SMTP_PASSWORD are unset, POST /auth/request-reset returns 503 (fail
# closed) instead of pretending an email went out. Defaults target Gmail:
#   1. Turn on 2-Step Verification for the Google account.
#   2. Create an app password at https://myaccount.google.com/apppasswords
#   3. SMTP_USERNAME = the Gmail address, SMTP_PASSWORD = the 16-char app password.
# Any other provider (SES, Mailgun, ...) works by overriding host/port -- no code change.
# NOTE: reset links are built from FRONTEND_ORIGIN above, so if that is wrong the
# emailed links point at the wrong host.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USERNAME=""
SMTP_PASSWORD=""
# From header; falls back to SMTP_USERNAME when empty.
SMTP_FROM=""

# NCBI E-utilities key for PubMed contact resolution (Optional)
# services/pubmed_contact.py resolves a PI's published corresponding-author address from
# PubMed, which is how NIH-funded labs get a contact at all -- RePORTER publishes no email
# (NSF does, via piEmail, and that path needs no key).
# Unlike the secrets above this one FAILS OPEN: unset just means PubMed throttles us to
# ~3 requests/second instead of ~10. It costs throughput, never capability.
# Free, instant: https://account.ncbi.nlm.nih.gov/settings/
NCBI_API_KEY=""

# HMAC key for signing the OAuth `state` parameter (Optional)
# `state` is signed so a callback cannot be forged for an arbitrary student. If unset,
# GOOGLE_CLIENT_SECRET is used, which is already a server-side secret -- set this only
# if you want to rotate the two independently.
OAUTH_STATE_SECRET=""

# Session JWT signing key. REQUIRED.
# Student-scoped routes verify a Bearer token signed with this. If it is unset the
# backend refuses to mint or verify tokens (500) rather than falling back to a
# guessable default -- a predictable key means anyone can forge any student's session.
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating this invalidates every existing session (everyone is signed out).
JWT_SECRET=""

# Session lifetime in seconds (Optional, default 2592000 = 30 days).
# There is no refresh flow, so this is how long a sign-in lasts before re-auth.
JWT_TTL_SECONDS="2592000"

# Admin secret gating GET /analytics/metrics, which returns per-student PII (ids, resume
# filenames, tester names) and the numbers launch decisions rest on. REQUIRED to view
# metrics: if unset, the endpoint is DISABLED (503) rather than open, so an unconfigured
# deploy fails closed. The admin dashboard sends it via the X-Admin-Secret header, read
# from the frontend's VITE_ANALYTICS_ADMIN_SECRET (which must match, and must NOT be
# embedded in a public production build). /analytics/log is intentionally NOT gated --
# it is anonymous browser telemetry.
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
ANALYTICS_ADMIN_SECRET=""

