# Supabase Configurations
# Obtain these from your Supabase Dashboard -> Project Settings -> API
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_KEY="your-supabase-service-role-key-or-anon-key"

# OpenAI API Key (Optional)
# Required for real high-fidelity semantic embeddings. 
# If left blank, the backend falls back to a deterministic local mock vector generator.
OPENAI_API_KEY=""

# Google OAuth Configurations (for real Gmail integration)
# Set up a Google Cloud Project with the Gmail API enabled, and configure the OAuth Consent Screen.
# Obtain these from Google Cloud Console -> Credentials -> OAuth 2.0 Client IDs.
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:8000/auth/google/callback"

