[Unit]
Description=LabMatch Caddy on 127.0.0.1:8080
After=labmatch-backend.service

[Service]
Environment=LABMATCH_ROOT=%h/Lab-Match-AI
ExecStart=%h/.local/bin/caddy run \
  --config %h/Lab-Match-AI/deploy/Caddyfile \
  --adapter caddyfile
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
